<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.thriftagent.poster</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/thrift-agent/.venv/bin/thrift</string>
    <string>poster</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/thrift-agent</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <!-- WO54 §4 (her working laptop comes first): below her apps, and inherited by what it starts (Poshmark's Playwright
       Chrome): Nice 10 lowers its CPU priority (Chrome's own QoS-classed threads keep their classes) and LowPriorityIO
       makes its disk I/O yield to hers. Not ProcessType Background: that would clamp Poshmark's Chrome to background QoS
       (efficiency cores, throttled I/O and network) and its form steps wait seconds at most; the poster's real relief
       is that both Chromes now close after 10 idle minutes. -->
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <!-- Seconds launchd waits after SIGTERM before SIGKILL (default 20): the poster finishes the current item first. -->
  <key>ExitTimeOut</key><integer>300</integer>
  <!-- Python block-buffers stdout when it is a file: unbuffered, so poster.log fills live and nothing is lost on kickstart. -->
  <key>EnvironmentVariables</key>
  <dict><key>PYTHONUNBUFFERED</key><string>1</string></dict>
  <key>StandardOutPath</key><string>__HOME__/thrift/logs/poster.log</string>
  <key>StandardErrorPath</key><string>__HOME__/thrift/logs/poster.err</string>
</dict>
</plist>
