{
  "_about": "Every page and step the extension recognises or fills (WO32): site -> pages / steps -> selector(s) -> how it is checked. A step is UNVERIFIED (\"verified\": false) until a dry run on the Mac recorded it working; the Python driver publishes only when the steps it needs are verified (same gate as WO30). Pages marked verified were seen live, with when and how.",
  "vinted": {
    "sell_url": "https://www.vinted.com/items/new",
    "listing_url": "^https://www\\.vinted\\.com/items/(\\d+)(?:-[^/?#]*)?/?(?:[?#].*)?$",
    "shop_url": "https://www.vinted.com/member/{shop}",
    "pages": {
      "block": {"selectors": ["iframe[src*='captcha-delivery']", "iframe[src*='geo.captcha-delivery']"],
                "text": "access denied|you have been blocked|unusual (activity|traffic)|403 forbidden", "verified": false},
      "captcha": {"selectors": ["iframe[title*='captcha' i]", "iframe[src*='hcaptcha']", "iframe[src*='recaptcha']"],
                  "text": "verify you are (a )?human|are you a robot", "verified": false},
      "login": {"selectors": ["[data-testid='header--login-button']", "a[href^='/member/signup']"],
                "text": "join and sell|already have an account\\??\\s*log in", "verified": true,
                "seen": "2026-10-06, WO30: /items/new logged out (\"Join and sell pre-loved clothes with no fees\")"},
      "verify": {"text": "verify (your|this) (account|phone|email)|confirm your (phone|email)|before you (list|upload)",
                 "verified": false},
      "form": {"selectors": ["[data-testid='title--input']", "input#title"], "verified": false}
    },
    "steps": {
      "photos": {"selectors": ["input[type='file']"], "drop": ["[data-testid*='photo-uploader' i]", "[data-testid*='dropzone' i]"],
                 "thumbs": ["[data-testid*='photo-uploader' i] img", "[data-testid*='image' i] img"],
                 "how": "the thumbnails counted after input.files is set", "verified": false},
      "title": {"selectors": ["[data-testid='title--input']", "input#title", "input[name='title']"], "verified": false},
      "description": {"selectors": ["[data-testid='description--input']", "textarea#description", "textarea[name='description']"],
                      "verified": false},
      "category": {"selectors": ["[data-testid='catalog-select-dropdown-input']", "input#catalog_id"],
                   "leaf": ["[id='catalog-{id}']", "[data-testid='catalog-select-dropdown-row-{id}']"],
                   "how": "the leaf by its id, else the tree walked by its path", "verified": false},
      "brand": {"selectors": ["[data-testid='brand-select-dropdown-input']", "input#brand_id"],
                "search": ["[data-testid='brand-select-dropdown-search-input']", "input[type='search']"], "verified": false},
      "size": {"selectors": ["[data-testid='size-select-dropdown-input']", "input#size_id"], "verified": false},
      "condition": {"selectors": ["[data-testid='condition-select-dropdown-input']", "input#status_id"], "verified": false},
      "color": {"selectors": ["[data-testid='color-select-dropdown-input']", "input#color"], "verified": false},
      "material": {"selectors": ["[data-testid='material-select-dropdown-input']", "input#material"], "verified": false},
      "skirt_length": {"selectors": ["[data-testid='skirt_length-select-dropdown-input']"], "verified": false},
      "rows": {"selectors": ["[role='option']", "[data-testid$='dropdown-row']", "[data-testid*='dropdown-row-']"],
               "how": "the option rows of the open dropdown, picked by their exact text", "verified": false},
      "price": {"selectors": ["[data-testid='price-input--input']", "input#price", "input[name='price']"], "verified": false},
      "package": {"selectors": ["input[type='radio'][name*='package' i]"], "how": "the radio whose label starts with the size",
                  "verified": false},
      "promo_close": {"selectors": ["[data-testid*='bump' i] button[aria-label*='close' i]",
                                    "[role='dialog'] button[aria-label*='close' i]"], "verified": false},
      "submit": {"selectors": ["[data-testid='upload-form-save-button']"], "text": "^upload$", "verified": false},
      "after_publish": {"how": "the tab lands on listing_url within 60 s", "verified": false},
      "listing_title": {"selectors": ["[data-testid='item-page-title']", "h1"], "verified": false},
      "listing_price": {"selectors": ["[data-testid='item-price']", "[itemprop='price']"], "verified": false},
      "listing_photos": {"selectors": ["[data-testid*='item-photo' i] img"], "verified": false},
      "hide": {"selectors": ["[data-testid='item-hide-button']", "button"], "text": "^hide$", "verified": false},
      "confirm": {"selectors": ["[role='dialog'] button"], "text": "^(hide|confirm|yes)$", "verified": false},
      "shop_links": {"selectors": ["a[href*='/items/']"], "verified": false}
    }
  },
  "depop": {
    "sell_url": "https://www.depop.com/products/create/",
    "listing_url": "^https://www\\.depop\\.com/products/(?!create/?$|edit/?$)([a-z0-9]+(?:-[a-z0-9]+)+)/?(?:[?#].*)?$",
    "shop_url": "https://www.depop.com/{shop}/",
    "pages": {
      "block": {"text": "sorry, not authorized|403 forbidden|were blocked|access denied", "verified": true,
                "seen": "2026-10-06, WO30: the Playwright-driven profile got Depop's 403 page (\"Sorry, not authorized\")"},
      "captcha": {"selectors": ["iframe[src*='captcha']", "iframe[title*='captcha' i]", "#px-captcha"],
                  "text": "press (and|&) hold|verify you are (a )?human", "verified": false},
      "login": {"selectors": ["form[action*='login' i]", "[data-testid='login__form']"],
                "text": "^\\s*log in\\s*$|sign up or log in|continue with email", "verified": true,
                "seen": "2026-10-06, WO30: /products/create/ logged out (title \"Log in\", \"Sign up or log in\")"},
      "form": {"selectors": ["textarea#description", "[id='group-input']"], "verified": false}
    },
    "steps": {
      "photos": {"selectors": ["input[type='file']"], "drop": ["[data-testid*='photo' i]", "[class*='PhotoUpload' i]"],
                 "thumbs": ["[data-testid*='photo' i] img", "[class*='PhotoUpload' i] img", "[class*='imageContainer' i] img"],
                 "how": "the thumbnails counted after input.files is set", "verified": false},
      "description": {"selectors": ["textarea#description", "textarea[name='description']", "[data-testid='description__input']"],
                      "verified": false},
      "combo": {"menu": "{id}-menu", "options": "[role='option']",
                "ids": {"category": "group-input", "brand": "brand-input", "condition": "condition-input",
                        "size": "variants-input", "colour": "colour-input", "source": "source-input",
                        "age": "age-input", "style": "style-input", "attribute": "attributes.{name}-input",
                        "shipping": "shippingMethods-input"},
                "how": "ids from data/depop_catalog.json (the logged-in form, 2026-10-06): cleared, typed, the option whose text IS the value",
                "verified": false},
      "price": {"selectors": ["input#price", "input[name='price']", "[data-testid='price__input']"], "verified": false},
      "package": {"selectors": ["input[type='radio'][name*='parcel' i]", "input[type='radio'][name*='package' i]",
                                "input[type='radio'][name*='size' i]"], "verified": false},
      "boost": {"selectors": ["input[type='checkbox'][name*='boost' i]", "[data-testid*='boost' i] input"],
                "how": "must read unchecked; never turned on", "verified": false},
      "submit": {"selectors": ["button[type='submit']"], "text": "^post$", "verified": false},
      "after_publish": {"how": "the tab lands on listing_url within 60 s", "verified": false},
      "listing_title": {"selectors": ["[data-testid='product__description']", "main p"], "verified": false},
      "listing_price": {"selectors": ["[data-testid='product__price']", "[aria-label*='price' i]"], "verified": false},
      "listing_photos": {"selectors": ["[data-testid*='product' i] img"], "verified": false},
      "mark_sold": {"selectors": ["button"], "text": "^mark as sold$", "verified": false},
      "confirm": {"selectors": ["[role='dialog'] button"], "text": "^(mark as sold|confirm|yes)$", "verified": false},
      "shop_links": {"selectors": ["a[href^='/products/']"], "verified": false}
    }
  }
}
